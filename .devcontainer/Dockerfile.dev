FROM python:3.11-slim

# Set environment variables
ENV PATH="/home/devuser/.local/bin:$PATH"
ENV POETRY_HOME="/home/devuser/.local"
ENV POETRY_VIRTUALENVS_IN_PROJECT=true

# Set the shell to /bin/bash and enable pipefail
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# Install dependencies
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    git \
    curl \
    make \
  && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools to the latest version
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Poetry for the root user
RUN curl -sSL https://install.python-poetry.org | python -

# Create a non-root user without a password
RUN useradd --create-home --shell /bin/bash devuser \
  && chown -R devuser:devuser /home/devuser

# Switch to the devuser
USER devuser
WORKDIR /workspaces
ENV POETRY_VIRTUALENVS_IN_PROJECT=false
ENV PYTHONPATH=".:$PYTHONPATH"
COPY bashrc /home/devuser/.bashrc

CMD ["bash"]
